    {
      "id": "dd52699c-d9cf-56ea-bf27-5ab620c6c9ee",
      "legacy_ref": "a4fe025d-3d9c-4131-8481-ec2718833b30",
      "slug": "language-programs",
      "parent_id": "b6294e86-00b7-5bb2-8fa3-50798665d2c4",
      "path": "/programs/language-programs",
      "sort_order": 2,
      "title": "Afternoon Language Program",
      "template": "programsumbrella",
      "blueprint": "programsumbrella",
      "published": true,
      "show_in_nav": true,
      "description": "Our Language Program runs daily from 3:00-6:00pm. We offer children a language immersion experience in French, Spanish, or Mandarin, as well as English in the Rainbow Room. Teachers in each of the four classrooms infuse art, music, outdoor exploration, print, and materials from other cultures into the daily experience of each child. The program includes language instruction as an organic part of a relaxed, nurturing learning environment supported with developmentally-appropriate arts, crafts, music, cooking, and outdoor play.",
      "short_description": "Our afternoon Language Program offers a unique, immersive experience in French, Mandarin, or Spanish for children ages 2.9 through 6 years old, whether they are fluent or just starting to explore the target language. Children in 1st through 4th grade may join our Mandarin Jade classroom. Toddler programming, primarily in English, is also available for children ages 1.9 to 2.9.",
      "intro": null,
      "welcome_line": null,
