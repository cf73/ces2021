    {
      "id": "d6ddc669-687b-5270-8465-4e19d846c075",
      "legacy_ref": "21904ad8-20a4-4672-a6eb-51204901e0e7",
      "slug": "summer-programs",
      "parent_id": "b6294e86-00b7-5bb2-8fa3-50798665d2c4",
      "path": "/programs/summer-programs",
      "sort_order": 5,
      "title": "Summer Programs",
      "template": "programsumbrellasummer",
      "blueprint": "programsumbrellasummer",
      "published": true,
      "show_in_nav": true,
      "description": "June and July are full of fun, exploration, and water play at our CES summer program! We offer 8:30-12:00pm, 8:30-4:00pm, and 8:30 to 5:00pm programming for Toddlers and Preschoolers alike. \n\nToddler-age classrooms are available for children 1.9-2.8. English preschool classes are for ages 2.9-5.11, and Language Immersion classrooms in French, Mandarin, and Spanish are available for children ages 3 to 6.11.\n\nEmail Katie@Cambridge-Ellis.org for more information.",
      "short_description": "In June and July, our English and Language Immersion programs drive our enriching and joyful summer program. Our playgrounds are transformed into outdoor classrooms with water play, art experiences, building materials, books and mud kitchens.\n\nOur hours are 8:30 to noon, 8:30 to 4:00pm, or 8:30 to 5. Toddler-age classrooms are available for children 1.9-2.8. English preschool classes are for ages 2.9-5.11, and Language Immersion classrooms in French, Mandarin, and Spanish are available for children over the age of 3 years and up through age 6.11. Email Katie@Cambridge-Ellis.org for more information.",
      "intro": null,
      "welcome_line": null,
      "main_image_asset_id": "31602795-9a92-58a7-8647-dd77e13de7f8",
      "program_image_asset_id": "86c3672b-afcb-5579-927f-0f0f32cb74f5",
